<%- include('../partials/head') %>
<div class="grid grid-side">
  <div class="card">
    <div class="card-header"><h2>Riwayat stok opname</h2></div>
    <div class="table-wrap"><table>
      <thead><tr><th>Tanggal</th><th>Produk</th><th class="num">Sistem</th><th class="num">Fisik</th><th class="num">Selisih</th><th class="num">Nilai</th><th>Petugas</th></tr></thead>
      <tbody>
      <% if (!history.length) { %><tr><td colspan="7" class="empty">Belum pernah melakukan opname.</td></tr><% } %>
      <% history.forEach(function (o) { %>
        <tr>
          <td><%= tgl(o.date) %></td><td><%= o.name %><% if (o.note) { %><br><small><%= o.note %></small><% } %></td>
          <td class="num"><%= o.system_qty %></td><td class="num"><%= o.physical_qty %></td>
          <td class="num <%= o.difference < 0 ? 'text-danger' : o.difference > 0 ? 'text-success' : '' %>"><%= o.difference > 0 ? '+' : '' %><%= o.difference %></td>
          <td class="num"><%= rp(o.value) %></td><td><%= o.user_name %></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  </div>

  <div class="card">
    <div class="card-header"><h2>Input hitungan fisik</h2></div>
    <div class="card-body">
      <form method="post" action="/inventory/opname" data-confirm="Simpan hasil opname? Stok sistem akan disesuaikan dengan jumlah fisik.">
        <div class="field">
          <label for="product">Produk <span class="req">*</span></label>
          <select id="product" name="product_id" required>
            <option value="">— Pilih produk —</option>
            <% products.forEach(function (p) { %><option value="<%= p.id %>" data-stock="<%= p.stock %>" data-unit="<%= p.unit %>" data-cost="<%= p.buy_price %>" <%= selected === p.id ? 'selected' : '' %>><%= p.name %></option><% }) %>
          </select>
        </div>
        <div class="field mt">
          <label>Stok menurut sistem</label>
          <input id="sys" readonly value="-">
        </div>
        <div class="field mt">
          <label for="physical">Jumlah fisik di rak/gudang <span class="req">*</span></label>
          <input id="physical" type="number" name="physical_qty" min="0" required>
        </div>
        <div id="diffInfo" class="alert alert-info mt" style="display:none"></div>
        <div class="field">
          <label for="note">Catatan</label>
          <input id="note" name="note" placeholder="mis. hasil hitung akhir bulan">
        </div>
        <div class="form-actions"><button class="btn">Simpan opname</button></div>
      </form>
    </div>
  </div>
</div>
<script>
  const sel = document.getElementById('product'), sys = document.getElementById('sys'), phys = document.getElementById('physical'), info = document.getElementById('diffInfo');
  function update() {
    const o = sel.selectedOptions[0];
    if (!o || !o.value) { sys.value = '-'; info.style.display = 'none'; return; }
    sys.value = o.dataset.stock + ' ' + o.dataset.unit;
    if (phys.value === '') { info.style.display = 'none'; return; }
    const diff = Number(phys.value) - Number(o.dataset.stock);
    info.style.display = '';
    info.className = 'alert mt ' + (diff < 0 ? 'alert-error' : diff > 0 ? 'alert-warning' : 'alert-success');
    info.textContent = diff === 0 ? 'Sesuai, tidak ada selisih.' :
      (diff < 0 ? 'Selisih kurang ' : 'Selisih lebih ') + Math.abs(diff) + ' ' + o.dataset.unit + ' (± ' + rp(Math.abs(diff) * o.dataset.cost) + ')';
  }
  sel.addEventListener('change', update); phys.addEventListener('input', update); update();
</script>
<%- include('../partials/foot') %>

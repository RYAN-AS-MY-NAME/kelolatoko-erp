<%- include('../partials/head') %>
<div class="kpis">
  <div class="kpi accent"><div class="label">Jumlah produk aktif</div><div class="value"><%= total %></div></div>
  <div class="kpi"><div class="label">Nilai persediaan</div><div class="value"><%= rp(totalValue) %></div></div>
  <div class="kpi warn"><div class="label">Menipis / habis</div><div class="value"><%= (counts.menipis || 0) + (counts.habis || 0) %></div></div>
  <div class="kpi <%= counts.mati ? 'bad' : '' %>"><div class="label">Stok mati</div><div class="value"><%= counts.mati || 0 %></div></div>
  <div class="kpi <%= expiredQty ? 'bad' : '' %>"><div class="label">Unit kedaluwarsa</div><div class="value"><%= expiredQty %></div></div>
</div>

<div class="toolbar">
  <form method="get" class="inline" style="display:flex;gap:8px;flex-wrap:wrap">
    <select name="status" onchange="this.form.submit()" aria-label="Filter status">
      <option value="">Semua status</option>
      <% Object.entries(STATUS_LABEL).forEach(function ([k, v]) { %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= v[0] %> (<%= counts[k] || 0 %>)</option><% }) %>
    </select>
  </form>
  <input type="search" id="filter" placeholder="Cari produk / SKU..." aria-label="Cari produk">
  <span class="spacer"></span>
  <% if (can('gudang')) { %>
  <form method="post" action="/purchases/reorder" class="inline" data-confirm="Buat PO draf otomatis untuk semua barang yang stoknya menipis?">
    <button class="btn"><%- icon('truck') %>Buat PO otomatis</button>
  </form>
  <% } %>
</div>

<div class="card">
  <div class="table-wrap">
    <table id="dataTable">
      <thead>
        <tr><th>Produk</th><th>Kategori</th><th class="num">Stok</th><th class="num">Min</th><th class="num">Nilai</th><th class="num">Terjual 30 hr</th><th class="num">Perkiraan habis</th><th>Kedaluwarsa terdekat</th><th>Status</th></tr>
      </thead>
      <tbody>
      <% if (!rows.length) { %><tr><td colspan="9" class="empty">Tidak ada produk dengan status ini.</td></tr><% } %>
      <% rows.forEach(function (p) { %>
        <tr>
          <td><a href="/inventory/card/<%= p.id %>"><%= p.name %></a><br><small><%= p.sku %></small></td>
          <td><%= p.category %></td>
          <td class="num fw"><%= num(p.stock) %> <small><%= p.unit %></small><% if (p.expired_qty) { %><br><small class="text-danger"><%= p.expired_qty %> kedaluwarsa</small><% } %></td>
          <td class="num"><%= p.min_stock %></td>
          <td class="num"><%= rp(p.value) %></td>
          <td class="num"><%= num(p.sold_30) %></td>
          <td class="num"><%= p.daysLeft === null ? '-' : p.daysLeft + ' hari' %></td>
          <td><%= p.next_expiry ? tgl(p.next_expiry) : '-' %></td>
          <td><span class="badge badge-<%= STATUS_LABEL[p.status][1] %>"><%= STATUS_LABEL[p.status][0] %></span></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<p class="muted" style="font-size:12.5px">Stok mati = ada stok tetapi tidak terjual selama 30 hari. Perkiraan habis dihitung dari rata-rata penjualan 30 hari terakhir.</p>
<script>
  document.getElementById('filter').addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase();
    document.querySelectorAll('#dataTable tbody tr').forEach((tr) => { tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none'; });
  });
</script>
<%- include('../partials/foot') %>

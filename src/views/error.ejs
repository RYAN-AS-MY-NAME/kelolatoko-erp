<% if (user) { %><%- include('partials/head') %><% } else { %>
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/static/css/style.css"></head><body><div class="content">
<% } %>
<div class="card" style="max-width:560px;margin:40px auto;text-align:center">
  <div class="card-body" style="padding:40px 24px">
    <div style="font-size:48px;font-weight:800;color:var(--primary)"><%= code %></div>
    <h2 style="margin:6px 0 10px"><%= title %></h2>
    <p class="muted"><%= message %></p>
    <div class="form-actions" style="justify-content:center">
      <a class="btn btn-ghost" href="javascript:history.back()">Kembali</a>
      <a class="btn" href="/">Ke Dashboard</a>
    </div>
  </div>
</div>
<% if (user) { %><%- include('partials/foot') %><% } else { %></div></body></html><% } %>

<%- include('../partials/head') %>
<div class="kpis">
  <div class="kpi accent"><div class="label">Saldo kas saat ini</div><div class="value"><%= rp(cash) %></div></div>
  <div class="kpi warn"><div class="label">Total pengeluaran periode ini</div><div class="value"><%= rp(total) %></div><div class="sub"><%= rows.length %> catatan</div></div>
</div>

<div class="grid grid-side">
  <div>
    <form method="get" class="toolbar">
      <div class="field"><label for="from">Dari</label><input id="from" type="date" name="from" value="<%= from %>"></div>
      <div class="field"><label for="to">Sampai</label><input id="to" type="date" name="to" value="<%= to %>"></div>
      <button class="btn btn-ghost">Tampilkan</button>
    </form>
    <div class="card">
      <div class="card-header"><h2>Uang keluar ke mana saja?</h2></div>
      <ul class="list">
        <% if (!byAccount.length) { %><li class="empty">Belum ada pengeluaran.</li><% } %>
        <% byAccount.forEach(function ([name, amt]) { %>
        <li style="display:block">
          <div style="display:flex;justify-content:space-between"><span><%= name %></span><strong><%= rp(amt) %> <small>(<%= Math.round(amt / total * 100) %>%)</small></strong></div>
          <div class="bar"><span style="width:<%= Math.round(amt / total * 100) %>%"></span></div>
        </li>
        <% }) %>
      </ul>
      <div class="card-body muted" style="font-size:12.5px">Pembelian stok dan gaji tidak dicatat di sini karena tercatat otomatis dari modul Pembelian dan SDM. Lihat semuanya di <a href="/reports/cash-flow">Laporan Arus Kas</a>.</div>
    </div>
    <div class="card">
      <div class="card-header"><h2>Daftar pengeluaran</h2></div>
      <div class="table-wrap"><table>
        <thead><tr><th>Tanggal</th><th>Kategori</th><th>Keterangan</th><th class="num">Jumlah</th><th>Oleh</th></tr></thead>
        <tbody>
        <% if (!rows.length) { %><tr><td colspan="5" class="empty">Belum ada pengeluaran.</td></tr><% } %>
        <% rows.forEach(function (e) { %>
          <tr><td><%= tgl(e.date) %></td><td><span class="badge badge-<%= e.account_code === '3102' ? 'warning' : 'secondary' %>"><%= e.account_name %></span></td><td><%= e.description %></td><td class="num"><%= rp(e.amount) %></td><td><%= e.user_name %></td></tr>
        <% }) %>
        </tbody>
      </table></div>
    </div>
  </div>

  <div>
    <div class="card">
      <div class="card-header"><h2>Catat pengeluaran</h2></div>
      <div class="card-body">
        <form method="post" action="/finance/expenses" novalidate>
          <div class="field"><label for="edate">Tanggal <span class="req">*</span></label><input id="edate" type="date" name="date" value="<%= today %>" required></div>
          <div class="field mt"><label for="acc">Kategori <span class="req">*</span></label>
            <select id="acc" name="account" required>
              <% accounts.forEach(function (a) { %><option value="<%= a.code %>"><%= a.name %></option><% }) %>
            </select>
            <span class="hint">Pilih <strong>Prive</strong> bila uang toko dipakai untuk keperluan pribadi, agar tidak tercampur dengan biaya usaha.</span>
          </div>
          <div class="field mt"><label for="eamt">Jumlah (Rp) <span class="req">*</span></label><input id="eamt" type="number" name="amount" min="1" required></div>
          <div class="field mt"><label for="edesc">Keterangan <span class="req">*</span></label><input id="edesc" name="description" placeholder="mis. Token listrik Oktober" required></div>
          <div class="form-actions"><button class="btn">Simpan pengeluaran</button></div>
        </form>
      </div>
    </div>
    <% if (user.role === 'owner') { %>
    <div class="card">
      <div class="card-header"><h2>Setor modal tambahan</h2></div>
      <div class="card-body">
        <form method="post" action="/finance/capital" data-confirm="Catat setoran modal ini?">
          <div class="field"><label for="cdate">Tanggal</label><input id="cdate" type="date" name="date" value="<%= today %>"></div>
          <div class="field mt"><label for="camt">Jumlah (Rp)</label><input id="camt" type="number" name="amount" min="1"></div>
          <div class="field mt"><label for="cdesc">Keterangan</label><input id="cdesc" name="description" placeholder="mis. tambahan modal dari tabungan"></div>
          <div class="form-actions"><button class="btn btn-ghost">Simpan setoran</button></div>
        </form>
      </div>
    </div>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>

<%- include('../partials/head') %>
<div class="kpis">
  <div class="kpi warn"><div class="label">Total bon belum dibayar</div><div class="value"><%= rp(total) %></div><div class="sub"><%= rows.length %> nota</div></div>
  <% const overdue = rows.filter(r => r.overdue > 0).reduce((s, r) => s + r.remaining, 0); %>
  <div class="kpi <%= overdue ? 'bad' : '' %>"><div class="label">Sudah lewat jatuh tempo</div><div class="value"><%= rp(overdue) %></div></div>
</div>

<div class="grid grid-side">
  <div class="card">
    <div class="card-header"><h2>Rincian bon per nota</h2></div>
    <div class="table-wrap"><table>
      <thead><tr><th>Nota</th><th>Pelanggan</th><th>Tanggal</th><th>Jatuh tempo</th><th class="num">Sisa</th><th>Terima bayar</th></tr></thead>
      <tbody>
      <% if (!rows.length) { %><tr><td colspan="6" class="empty">Tidak ada bon yang belum dibayar.</td></tr><% } %>
      <% rows.forEach(function (s) { %>
        <tr>
          <td><a href="/sales/<%= s.id %>"><%= s.code %></a></td>
          <td><%= s.customer_name %></td>
          <td><%= tgl(s.date) %></td>
          <td class="nw"><%= tgl(s.due_date) %><% if (s.overdue > 0) { %> <span class="badge badge-danger">Terlambat <%= s.overdue %> hari</span><% } %></td>
          <td class="num fw"><%= rp(s.remaining) %></td>
          <td>
            <form method="post" action="/sales/<%= s.id %>/pay" style="display:flex;gap:6px" data-confirm="Catat pembayaran bon <%= s.code %>?">
              <input type="hidden" name="back" value="/finance/receivables">
              <input type="number" name="amount" value="<%= s.remaining %>" min="1" max="<%= s.remaining %>" style="width:110px" aria-label="Jumlah bayar">
              <button class="btn btn-sm">Terima</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  </div>
  <div class="card">
    <div class="card-header"><h2>Rekap per pelanggan</h2></div>
    <ul class="list">
      <% if (!byCustomer.length) { %><li class="empty">-</li><% } %>
      <% byCustomer.forEach(function (c) { %>
        <li><span><strong><%= c.name %></strong><br><small><%= c.phone %> · <%= c.n %> nota</small></span>
          <span style="text-align:right"><strong><%= rp(c.total) %></strong><% if (c.overdue) { %><br><small class="text-danger">terlambat <%= rp(c.overdue) %></small><% } %></span></li>
      <% }) %>
    </ul>
  </div>
</div>
<%- include('../partials/foot') %>

<%- include('../partials/head') %>
<%- include('../partials/report_filter') %>
<div class="card report">
  <div class="report-head">
    <h2>AMART</h2>
    <div>Neraca</div>
    <small>Per <%= tgl(asOf) %></small>
  </div>
  <div class="card-body">
    <table>
      <tr class="section"><td colspan="2">ASET</td></tr>
      <% bs.assets.forEach(function (a) { %><tr><td class="indent"><%= a.name %></td><td class="num"><%= rp(a.balance) %></td></tr><% }) %>
      <tr class="grand"><td>TOTAL ASET</td><td class="num"><%= rp(bs.totalAssets) %></td></tr>

      <tr class="section"><td colspan="2">KEWAJIBAN</td></tr>
      <% bs.liabilities.forEach(function (a) { %><tr><td class="indent"><%= a.name %></td><td class="num"><%= rp(a.balance) %></td></tr><% }) %>
      <tr class="total"><td>Total kewajiban</td><td class="num"><%= rp(bs.totalLiabilities) %></td></tr>

      <tr class="section"><td colspan="2">MODAL</td></tr>
      <% bs.equity.forEach(function (a) { %><tr><td class="indent"><%= a.name %></td><td class="num"><%= a.balance < 0 ? '(' + rp(-a.balance) + ')' : rp(a.balance) %></td></tr><% }) %>
      <tr><td class="indent">Laba (rugi) berjalan</td><td class="num"><%= rp(bs.currentProfit) %></td></tr>
      <tr class="total"><td>Total modal</td><td class="num"><%= rp(bs.totalEquity) %></td></tr>

      <tr class="grand"><td>TOTAL KEWAJIBAN + MODAL</td><td class="num"><%= rp(bs.totalLiabilities + bs.totalEquity) %></td></tr>
    </table>
    <div class="alert <%= bs.balanced ? 'alert-success' : 'alert-error' %> mt">
      <%= bs.balanced ? 'Neraca seimbang: Aset = Kewajiban + Modal. Semua transaksi tercatat dengan benar (double-entry).' : 'Neraca TIDAK seimbang. Periksa jurnal.' %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>

<%- include('../partials/head') %>
<div class="toolbar"><span class="spacer"></span><button type="button" class="btn btn-ghost" data-print><%- icon('print') %>Cetak / simpan PDF</button></div>
<div class="kpis">
  <div class="kpi accent"><div class="label">Total nilai persediaan</div><div class="value"><%= rp(totalValue) %></div></div>
  <div class="kpi <%= deadValue ? 'bad' : '' %>"><div class="label">Modal tertahan di stok mati</div><div class="value"><%= rp(deadValue) %></div><div class="sub"><%= totalValue ? Math.round(deadValue / totalValue * 100) : 0 %>% dari persediaan</div></div>
  <div class="kpi warn"><div class="label">Stok lambat laku (&gt;60 hari)</div><div class="value"><%= rp(slowValue) %></div></div>
</div>
<div class="alert alert-info">
  <strong>Perputaran stok (30 hari)</strong> = HPP 30 hari ÷ nilai stok saat ini. Angka &gt; 1 berarti stok berputar lebih dari sekali sebulan (sehat).
  Angka mendekati 0 berarti modal tertahan. Gunakan laporan ini untuk menghentikan pembelian barang yang tidak laku.
</div>
<div class="card">
  <div class="table-wrap"><table>
    <thead><tr><th>Produk</th><th class="num">Stok</th><th class="num">Nilai stok</th><th class="num">% nilai</th><th class="num">Terjual 30 hr</th><th class="num">Perputaran</th><th class="num">Cukup untuk</th><th>Terakhir laku</th><th>Status</th></tr></thead>
    <tbody>
    <% rows.forEach(function (p) { %>
      <tr>
        <td><a href="/inventory/card/<%= p.id %>"><%= p.name %></a></td>
        <td class="num"><%= num(p.stock) %> <small><%= p.unit %></small></td>
        <td class="num"><%= rp(p.value) %></td>
        <td class="num"><%= totalValue ? (p.value / totalValue * 100).toFixed(1).replace('.', ',') : 0 %>%</td>
        <td class="num"><%= num(p.sold_30) %></td>
        <td class="num <%= p.turnover < 0.3 ? 'text-danger' : p.turnover >= 1 ? 'text-success' : '' %>"><%= p.turnover.toFixed(2).replace('.', ',') %>×</td>
        <td class="num"><%= p.daysLeft === null ? '∞' : p.daysLeft + ' hari' %></td>
        <td><%= p.last_sale ? tgl(p.last_sale) : 'Belum pernah' %></td>
        <td><span class="badge badge-<%= STATUS_LABEL[p.status][1] %>"><%= STATUS_LABEL[p.status][0] %></span></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</div>
<%- include('../partials/foot') %>

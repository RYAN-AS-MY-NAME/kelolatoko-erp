<%- include('../partials/head') %>
<form method="get" class="toolbar">
  <div class="field"><label for="from">Dari</label><input id="from" type="date" name="from" value="<%= from %>"></div>
  <div class="field"><label for="to">Sampai</label><input id="to" type="date" name="to" value="<%= to %>"></div>
  <button class="btn btn-ghost">Tampilkan</button>
  <span class="spacer"></span>
  <% if (can('kasir')) { %><a class="btn" href="/pos"><%- icon('cart') %>Transaksi baru</a><% } %>
</form>

<div class="kpis">
  <div class="kpi accent"><div class="label">Jumlah transaksi</div><div class="value"><%= num(sum.n) %></div></div>
  <div class="kpi accent"><div class="label">Total penjualan</div><div class="value"><%= rp(sum.total) %></div></div>
  <% if (can('keuangan')) { %><div class="kpi"><div class="label">Laba kotor</div><div class="value"><%= rp(sum.gp) %></div></div><% } %>
  <div class="kpi"><div class="label">Rata-rata per transaksi</div><div class="value"><%= rp(sum.n ? sum.total / sum.n : 0) %></div></div>
</div>

<div class="card">
  <div class="table-wrap"><table>
    <thead><tr><th>Nota</th><th>Tanggal</th><th>Pelanggan</th><th>Kasir</th><th class="num">Item</th><th class="num">Total</th><th>Status</th></tr></thead>
    <tbody>
    <% if (!rows.length) { %><tr><td colspan="7" class="empty">Tidak ada transaksi pada periode ini.</td></tr><% } %>
    <% rows.forEach(function (s) { %>
      <tr>
        <td><a href="/sales/<%= s.id %>"><%= s.code %></a></td>
        <td><%= tgl(s.date) %></td>
        <td><%= s.customer_name || 'Umum' %></td>
        <td><%= s.cashier %></td>
        <td class="num"><%= s.items %></td>
        <td class="num"><%= rp(s.total) %></td>
        <td><span class="badge badge-<%= s.status === 'selesai' ? 'success' : 'danger' %>"><%= s.status === 'selesai' ? 'Selesai' : 'Batal' %></span></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</div>
<%- include('../partials/foot') %>

<%- include('partials/head') %>
<div class="pos">
  <div class="card">
    <div class="card-header" style="gap:8px">
      <input type="search" id="search" placeholder="Cari nama / scan SKU lalu Enter..." style="flex:1;min-width:200px" autofocus aria-label="Cari produk">
      <select id="cat" style="width:auto" aria-label="Kategori">
        <option value="">Semua kategori</option>
        <% categories.forEach(function (c) { %><option><%= c %></option><% }) %>
      </select>
    </div>
    <div class="card-body"><div class="product-grid" id="grid"></div></div>
  </div>

  <div class="card">
    <div class="card-header"><h2><%- icon('cart') %> Keranjang</h2><button class="btn btn-sm btn-ghost" id="clear" type="button">Kosongkan</button></div>
    <div class="card-body">
      <div id="posError" class="alert alert-error" role="alert" style="display:none"></div>
      <div class="table-wrap">
        <table class="cart-table">
          <tbody id="cart"></tbody>
        </table>
      </div>
      <div id="emptyCart" class="empty">Belum ada barang. Klik produk di sebelah kiri.</div>

      <div class="field mt">
        <label for="customer">Pelanggan</label>
        <select id="customer">
          <option value="">Umum (tanpa nama)</option>
          <% customers.forEach(function (c) { %><option value="<%= c.id %>" data-limit="<%= c.credit_limit %>" data-debt="<%= c.debt %>"><%= c.name %></option><% }) %>
        </select>
        <span class="hint" id="custInfo"></span>
      </div>

      <div class="field mt">
        <label>Metode pembayaran</label>
        <div class="seg">
          <label><input type="radio" name="method" value="tunai" checked><span>Tunai</span></label>
          <label><input type="radio" name="method" value="kredit"><span>Bon (kredit)</span></label>
        </div>
      </div>

      <div class="form-grid mt" style="grid-template-columns:1fr 1fr">
        <div class="field"><label for="discount">Diskon (Rp)</label><input id="discount" type="number" min="0" value="0"></div>
        <div class="field" id="cashField"><label for="cash">Uang diterima (Rp)</label><input id="cash" type="number" min="0" placeholder="= total"></div>
      </div>

      <div class="totals">
        <div><span>Subtotal</span><span id="subtotal">Rp 0</span></div>
        <div><span>Diskon</span><span id="discView">Rp 0</span></div>
        <div class="grand"><span>Total</span><span id="total">Rp 0</span></div>
        <div id="changeRow"><span>Kembalian</span><strong id="change">Rp 0</strong></div>
      </div>
      <button class="btn btn-lg btn-block mt" id="pay" type="button" disabled>Bayar &amp; simpan transaksi</button>
      <p class="muted" style="font-size:12px;margin:8px 0 0">Stok berkurang otomatis (FEFO), kas/piutang dan jurnal tercatat otomatis. Barang kedaluwarsa tidak bisa dijual.</p>
    </div>
  </div>
</div>

<script>
  const PRODUCTS = <%- json(products) %>;
  const cart = new Map();
  const $ = (id) => document.getElementById(id);
  const byId = (id) => PRODUCTS.find((p) => p.id === id);

  function renderGrid() {
    const q = $('search').value.toLowerCase().trim(), cat = $('cat').value;
    $('grid').innerHTML = '';
    PRODUCTS.filter((p) => (!cat || p.category === cat) && (!q || p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q)))
      .forEach((p) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'product-tile'; b.disabled = p.stock <= 0;
        b.innerHTML = '<span class="name"></span><span class="stock"></span><span class="price"></span>';
        b.querySelector('.name').textContent = p.name;
        b.querySelector('.stock').textContent = p.stock > 0 ? 'Stok ' + p.stock + ' ' + p.unit : 'Stok habis';
        b.querySelector('.price').textContent = rp(p.sell_price);
        b.addEventListener('click', () => add(p.id));
        $('grid').appendChild(b);
      });
  }

  function add(id, n = 1) {
    const p = byId(id), cur = cart.get(id) || 0;
    if (cur + n > p.stock) { showError('Stok ' + p.name + ' hanya ' + p.stock + ' ' + p.unit + '.'); return; }
    cart.set(id, cur + n); hideError(); renderCart();
  }

  function setQty(id, q) {
    const p = byId(id);
    q = Math.floor(Number(q) || 0);
    if (q <= 0) cart.delete(id);
    else if (q > p.stock) { showError('Stok ' + p.name + ' hanya ' + p.stock + ' ' + p.unit + '.'); cart.set(id, p.stock); }
    else cart.set(id, q);
    renderCart();
  }

  function totals() {
    let subtotal = 0;
    cart.forEach((q, id) => { subtotal += q * byId(id).sell_price; });
    const discount = Math.min(Math.max(Number($('discount').value) || 0, 0), subtotal);
    return { subtotal, discount, total: subtotal - discount };
  }

  function renderCart() {
    const body = $('cart'); body.innerHTML = '';
    cart.forEach((q, id) => {
      const p = byId(id), tr = document.createElement('tr');
      tr.innerHTML = '<td><div class="fw name"></div><small class="price"></small></td>' +
        '<td><div class="qty"><button type="button" data-d="-1">−</button><input type="number" min="0"><button type="button" data-d="1">+</button></div></td>' +
        '<td class="num line"></td>';
      tr.querySelector('.name').textContent = p.name;
      tr.querySelector('.price').textContent = rp(p.sell_price) + ' / ' + p.unit;
      tr.querySelector('input').value = q;
      tr.querySelector('.line').textContent = rp(q * p.sell_price);
      tr.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => setQty(id, q + Number(b.dataset.d))));
      tr.querySelector('input').addEventListener('change', (e) => setQty(id, e.target.value));
      body.appendChild(tr);
    });
    $('emptyCart').style.display = cart.size ? 'none' : '';
    const t = totals(), method = document.querySelector('input[name=method]:checked').value;
    $('subtotal').textContent = rp(t.subtotal);
    $('discView').textContent = '− ' + rp(t.discount);
    $('total').textContent = rp(t.total);
    const cash = $('cash').value === '' ? t.total : Number($('cash').value);
    const change = cash - t.total;
    $('change').textContent = rp(Math.max(change, 0));
    $('change').className = change < 0 ? 'text-danger' : '';
    $('cashField').style.display = $('changeRow').style.display = method === 'tunai' ? '' : 'none';
    $('pay').disabled = !cart.size;
    const c = $('customer').selectedOptions[0];
    $('custInfo').textContent = c.value ? 'Limit bon ' + rp(c.dataset.limit) + ' · bon berjalan ' + rp(c.dataset.debt) : '';
  }

  function showError(msg) { $('posError').textContent = msg; $('posError').style.display = ''; }
  function hideError() { $('posError').style.display = 'none'; }

  $('search').addEventListener('input', renderGrid);
  $('cat').addEventListener('change', renderGrid);
  $('search').addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const q = e.target.value.trim().toLowerCase();
    const p = PRODUCTS.find((x) => x.sku.toLowerCase() === q) || PRODUCTS.filter((x) => x.name.toLowerCase().includes(q) && x.stock > 0)[0];
    if (p) { add(p.id); e.target.value = ''; renderGrid(); } else showError('Produk "' + e.target.value + '" tidak ditemukan.');
  });
  ['discount', 'cash', 'customer'].forEach((id) => $(id).addEventListener('input', renderCart));
  $('customer').addEventListener('change', renderCart);
  document.querySelectorAll('input[name=method]').forEach((r) => r.addEventListener('change', renderCart));
  $('clear').addEventListener('click', () => { cart.clear(); hideError(); renderCart(); });

  $('pay').addEventListener('click', async () => {
    const t = totals(), method = document.querySelector('input[name=method]:checked').value;
    if (method === 'kredit' && !$('customer').value) { showError('Penjualan bon wajib memilih pelanggan.'); return; }
    $('pay').disabled = true; $('pay').textContent = 'Menyimpan...';
    try {
      const res = await fetch('/pos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          items: [...cart].map(([productId, qty]) => ({ productId, qty })),
          customerId: $('customer').value || null,
          method, discount: t.discount,
          cashReceived: method === 'tunai' && $('cash').value !== '' ? Number($('cash').value) : null,
        }),
      });
      const data = await res.json().catch(() => ({ error: 'Respons server tidak valid.' }));
      if (!res.ok) throw new Error(data.error || 'Gagal menyimpan transaksi.');
      window.location = '/sales/' + data.id + '?new=1';
    } catch (err) {
      showError(err.message === 'Failed to fetch' ? 'Tidak dapat terhubung ke server. Periksa koneksi lalu coba lagi.' : err.message);
      $('pay').disabled = false; $('pay').textContent = 'Bayar & simpan transaksi';
    }
  });

  renderGrid(); renderCart();
</script>
<%- include('partials/foot') %>

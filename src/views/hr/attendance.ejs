<%- include('../partials/head') %>
<form method="get" class="toolbar">
  <div class="field"><label for="date">Tanggal</label><input id="date" type="date" name="date" value="<%= date %>" onchange="this.form.submit()"></div>
</form>

<div class="grid grid-2">
  <div class="card">
    <div class="card-header"><h2>Absensi <%= tgl(date) %></h2>
      <button type="button" class="btn btn-sm btn-ghost" id="allPresent">Tandai semua hadir</button></div>
    <form method="post" action="/hr/attendance">
      <input type="hidden" name="date" value="<%= date %>">
      <div class="table-wrap"><table>
        <thead><tr><th>Karyawan</th><% STATUSES.forEach(function (s) { %><th style="text-align:center;text-transform:capitalize"><%= s %></th><% }) %></tr></thead>
        <tbody>
        <% if (!rows.length) { %><tr><td colspan="5" class="empty">Belum ada karyawan aktif.</td></tr><% } %>
        <% rows.forEach(function (e) { %>
          <tr>
            <td><strong><%= e.name %></strong><br><small><%= e.position %></small></td>
            <% STATUSES.forEach(function (s) { %>
              <td style="text-align:center"><input type="radio" name="s_<%= e.id %>" value="<%= s %>" <%= e.status === s ? 'checked' : '' %> aria-label="<%= e.name %> <%= s %>" style="width:auto"></td>
            <% }) %>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
      <div class="card-body"><button class="btn">Simpan absensi</button></div>
    </form>
  </div>

  <div class="card">
    <div class="card-header"><h2>Rekap <%= bulan(period) %></h2><a class="btn btn-sm btn-ghost" href="/hr/payroll?period=<%= period %>">Hitung gaji →</a></div>
    <div class="table-wrap"><table>
      <thead><tr><th>Karyawan</th><th class="num">Hadir</th><th class="num">Izin</th><th class="num">Sakit</th><th class="num">Alpa</th></tr></thead>
      <tbody>
      <% recap.forEach(function (r) { %>
        <tr><td><%= r.name %></td><td class="num"><%= r.hadir || 0 %></td><td class="num"><%= r.izin || 0 %></td><td class="num"><%= r.sakit || 0 %></td><td class="num <%= r.alpa ? 'text-danger' : '' %>"><%= r.alpa || 0 %></td></tr>
      <% }) %>
      </tbody>
    </table></div>
  </div>
</div>
<script>
  document.getElementById('allPresent').addEventListener('click', () => {
    document.querySelectorAll('input[type=radio][value=hadir]').forEach((r) => { r.checked = true; });
  });
</script>
<%- include('../partials/foot') %>

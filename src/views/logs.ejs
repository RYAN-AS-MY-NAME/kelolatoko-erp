<%- include('partials/head') %>
<div class="alert alert-info">Jejak audit: setiap aksi penting tercatat beserta pelakunya, untuk kontrol internal pemilik toko.</div>
<div class="card">
  <div class="table-wrap"><table>
    <thead><tr><th>Waktu</th><th>Pengguna</th><th>Aksi</th><th>Detail</th></tr></thead>
    <tbody>
    <% rows.forEach(function (l) { %>
      <tr><td style="white-space:nowrap"><%= tgl(l.created_at) %> <%= l.created_at.slice(11, 16) %></td><td><%= l.user_name %> <small>(<%= ROLES[l.role] %>)</small></td><td><%= l.action %></td><td><%= l.detail || '-' %></td></tr>
    <% }) %>
    </tbody>
  </table></div>
</div>
<%- include('partials/foot') %>

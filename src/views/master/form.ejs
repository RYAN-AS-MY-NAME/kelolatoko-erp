<%- include('../partials/head') %>
<div class="card" style="max-width:900px">
  <div class="card-header"><h2><%= id ? 'Ubah' : 'Tambah' %> data <%= cfg.singular %></h2></div>
  <div class="card-body">
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/master/<%= entity %><%= id ? '/' + id : '' %>" novalidate>
      <div class="form-grid">
        <% fields.forEach(function (f) { const v = values[f.name] === null || values[f.name] === undefined ? '' : String(values[f.name]); %>
        <div class="field" <% if (f.type === 'textarea') { %>style="grid-column:1/-1"<% } %>>
          <label for="f_<%= f.name %>"><%= f.label %><% if (f.required) { %> <span class="req">*</span><% } %></label>
          <% if (f.type === 'select') { %>
            <select id="f_<%= f.name %>" name="<%= f.name %>" <%= f.required ? 'required' : '' %>>
              <% if (!f.default) { %><option value="">— Pilih —</option><% } %>
              <% f.opts.forEach(function (o) { %><option value="<%= o.value %>" <%= String(o.value) === v ? 'selected' : '' %>><%= o.label %></option><% }) %>
            </select>
          <% } else if (f.type === 'textarea') { %>
            <textarea id="f_<%= f.name %>" name="<%= f.name %>"><%= v %></textarea>
          <% } else if (f.type === 'password') { %>
            <input id="f_<%= f.name %>" type="password" name="<%= f.name %>" autocomplete="new-password">
          <% } else { %>
            <input id="f_<%= f.name %>" type="<%= f.type === 'number' ? 'number' : f.type === 'date' ? 'date' : 'text' %>" name="<%= f.name %>" value="<%= v %>" <%= f.type === 'number' ? 'min=0 step=1 inputmode=numeric' : '' %> <%= f.required ? 'required' : '' %>>
          <% } %>
          <% if (f.hint) { %><span class="hint"><%= f.hint %></span><% } %>
        </div>
        <% }) %>
      </div>
      <div class="form-actions">
        <button class="btn">Simpan</button>
        <a class="btn btn-ghost" href="/master/<%= entity %>">Batal</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>

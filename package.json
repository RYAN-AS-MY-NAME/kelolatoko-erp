{
  "name": "sembako-erp",
  "version": "1.0.0",
  "description": "Sistem ERP berbasis web untuk toko sembako / minimarket (Tugas UTS Sistem Informasi Enterprise)",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "seed": "node --no-warnings scripts/db-setup.js --reset",
    "test": "node --no-warnings --test --test-concurrency=1 tests/e2e.test.js",
    "db:setup": "node --no-warnings scripts/db-setup.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "connect-pg-simple": "10.0.0",
    "ejs": "3.1.10",
    "express": "5.3.0",
    "express-session": "1.18.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}

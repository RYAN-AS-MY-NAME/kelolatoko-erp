{
  "name": "sembako-erp",
  "version": "1.0.0",
  "description": "Sistem ERP berbasis web untuk toko sembako / minimarket (Tugas UTS Sistem Informasi Enterprise)",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "seed": "node --no-warnings seed.js",
    "test": "node --no-warnings --test --test-concurrency=1 tests/e2e.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "chart.js": "4.4.7",
    "ejs": "3.1.10",
    "express": "4.21.2",
    "express-session": "1.18.1"
  }
}
